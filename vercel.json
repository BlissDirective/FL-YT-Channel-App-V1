{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install",
  "crons": [
    { "path": "/api/cron/build-runner", "schedule": "*/5 * * * *" },
    { "path": "/api/cron/refresh-stats", "schedule": "10 7 * * *" },
    { "path": "/api/cron/intelligence", "schedule": "30 6 * * *" },
    { "path": "/api/cron/optimizer", "schedule": "0 8 * * 1" }
  ]
}
