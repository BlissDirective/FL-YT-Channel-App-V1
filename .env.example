# Supabase (Phase 0)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Orchestration (Phase 3)
TRIGGER_SECRET_KEY=

# Web push notifications (Phase 3) — generate with `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# AI providers (Phase 4)
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
# Optional: script writer model. Default claude-sonnet-4-6 (~$0.05/script).
# Set to claude-opus-4-8 for flagship quality (~$0.25–0.30/script, ~5x).
SCRIPT_MODEL=

# Cloudflare R2 (optional) — S3-compatible object storage for finished video
# renders. When all four are set, long + short renders are stored in R2 (no
# per-file size cap, zero egress) instead of Supabase Storage, so any video is
# downloadable regardless of size. The app reads these to presign download
# links; the render farm writes renders here. Leave unset to use Supabase.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Media & data (Phase 5, 7)
FAL_KEY=
PEXELS_API_KEY=
# YouTube Data API v3 key (Phase 7) — API key only, no OAuth. Public stats
# tracking + niche research. The YOUTUBE_DATA_API_V3 alias is also accepted.
YOUTUBE_API_KEY=

# Gemini API key (Phase C) — deep Video Intelligence perception. Gemini ingests
# a public YouTube URL natively (no download). Unset = deep scans run in mock.
GEMINI_API_KEY=
# Optional model override (default gemini-2.5-flash).
GEMINI_MODEL=

# Nightly stats cron auth (Phase 7) — shared secret between the Stats Refresh
# Action and /api/cron/refresh-stats. Unset = route runs unguarded (mock/dev).
CRON_SECRET=

# Studio MCP server (Phase 9) — scoped bearer token for /api/mcp. Unset =
# the MCP endpoint is closed (503). Generate: openssl rand -hex 32
STUDIO_MCP_TOKEN=
