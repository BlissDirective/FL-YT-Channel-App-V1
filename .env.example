# Supabase (Phase 0)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Orchestration (Phase 3)
TRIGGER_SECRET_KEY=

# Web push notifications (Phase 3) — generate with `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# AI providers (Phase 4)
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=

# Media & data (Phase 5, 7)
FAL_KEY=
PEXELS_API_KEY=
# YouTube Data API v3 key (Phase 7) — API key only, no OAuth. Public stats
# tracking + niche research. The YOUTUBE_DATA_API_V3 alias is also accepted.
YOUTUBE_API_KEY=

# Nightly stats cron auth (Phase 7) — shared secret between the Stats Refresh
# Action and /api/cron/refresh-stats. Unset = route runs unguarded (mock/dev).
CRON_SECRET=
